DATABASE_URL=postgres://user:password@localhost:5432/sml
DATABASE_SSL=off
SML_NEWS_INGEST_TOKEN=replace-with-a-long-random-token
OPENAI_API_KEY=replace-in-secret-manager
SML_NEWS_OPENAI_MODEL=gpt-5-mini
SML_WORDPRESS_URL=https://stockmarketloop.com
SML_WORDPRESS_USERNAME=stockmarketloop
SML_WORDPRESS_APP_PASSWORD=replace-with-wordpress-application-password
SML_WORDPRESS_AUTHOR_SLUG=stockmarketloop
SML_WORDPRESS_AUTHOR_NAME=SML NEWS

# Academy private-data bridge. Configure the same high-entropy secret on the
# WordPress side; neither value may appear in browser JavaScript or git.
SML_ACADEMY_BRIDGE_URL=https://stockmarketloop.com
SML_ACADEMY_BRIDGE_SECRET=replace-with-a-32-plus-character-secret

# --- dispute-evidence system (every surface fails closed while unset) ---
# SML_DISPUTE_EVIDENCE_ENABLED=1        # enables Stripe dispute cases, ledgers, admin endpoints, sweeps
# SML_EVIDENCE_ENCRYPTION_KEY=          # comma-separated key list; first entry encrypts, all decrypt (AES-256-GCM via HKDF)
# SML_PAYPAL_ENABLED=1
# SML_PAYPAL_ENV=sandbox                # sandbox | live
# SML_PAYPAL_CLIENT_ID=
# SML_PAYPAL_CLIENT_SECRET=
# SML_PAYPAL_WEBHOOK_ID=                # webhook id registered in the PayPal developer dashboard
# SML_CONNECT_BOT_ENABLED=1
# SML_DISCORD_CONNECT_PUBLIC_KEY=       # SML Connect application's Ed25519 public key (hex)
# SML_DISCORD_CONNECT_APP_ID=
# SML_DISCORD_CONNECT_BOT_TOKEN=        # worker only: private DM alerts + command registration
# SML_CONNECT_GUILD_IDS=                # comma-separated guild ids for command registration
# SML_CONNECT_REVIEW_URL_SECRET=        # signs short-lived review-page approval references
# SML_CONNECT_REVIEW_URL_BASE=https://stockmarketloop.com/connect-review/
# SML_UC_WEBHOOK_PATH_TOKEN=            # unguessable path segment for POST /v1/upgrade-chat/webhook/{token}
# --- bounded Claude/Codex planning and review queue (worker only) ---
# SML_AI_ORCHESTRATOR_ENABLED=0         # explicit kill switch; leave off until both providers are configured
# ANTHROPIC_API_KEY=                    # secret manager only
# OPENAI_API_KEY=                       # already used by the newsroom; secret manager only
# SML_AI_OPENAI_MODEL=gpt-5.4-mini
# SML_AI_ANTHROPIC_MODEL=claude-sonnet-5
# SML_AI_MAX_OUTPUT_TOKENS=3000
# SML_AI_MAX_TASKS_PER_TICK=1           # hard-capped to 3 in code
# SML_AI_VERIFY_HOSTS=sml-platform-api.onrender.com,stockmarketloop.com
# Set current provider prices; zero keeps accounting visible but cannot enforce a meaningful money ceiling.
# SML_AI_OPENAI_INPUT_USD_PER_MILLION=0
# SML_AI_OPENAI_OUTPUT_USD_PER_MILLION=0
# SML_AI_ANTHROPIC_INPUT_USD_PER_MILLION=0
# SML_AI_ANTHROPIC_OUTPUT_USD_PER_MILLION=0

# --- separate Making Easy Money Academy Discord application ---
# SML_ACADEMY_ENABLED=1
# SML_ACADEMY_PUBLIC_KEY=                # separate Academy application's Ed25519 public key
# SML_ACADEMY_APP_ID=                    # separate Academy application id
# SML_ACADEMY_CLIENT_SECRET=             # separate Academy OAuth2 client secret; never expose to the browser
# SML_ACADEMY_BOT_TOKEN=                 # separate Academy bot token; never reuse Connect's token
# SML_ACADEMY_GUILD_ID=
# SML_ACADEMY_CATEGORY_ID=
# SML_ACADEMY_MANAGER_ROLE_ID=

# --- MEM Academy gate + billing engine: every switch off while unset ---
# Full list, per-service placement and the staged enable: platform/academy/billing/LAUNCH.md
# SML_ACADEMY_ACCESS_ROLE_IDS=           # API + academy: the 'Academy Student' role id (Lifetime also grants Monarch, admitted by MONARCH_ACCESS)
# SML_ACADEMY_MEMBER_ROLE_IDS=           # API + academy: member-tier roles (live alerts), optional
# SML_ACADEMY_MONARCH_ACCESS=1           # API + academy: '0' drops Monarch (phase 2: verified-payer roster first)
# SML_ACADEMY_FREE_SESSIONS=0            # API: 'free' sessions for roleless guild members
# SML_ACADEMY_CONTENT_GATE_ENABLED=0     # API: lesson + live-data gate for free/anonymous callers
# SML_ACADEMY_FREE_PREVIEW=M0,M29:1-10   # API + academy hub
# SML_ACADEMY_FREE_SYMBOLS=SPY,QQQ       # API
# SML_ACADEMY_ALERTS_TIERING=0           # API: 'academy' tier sees closed alerts only
# SML_ACADEMY_HUB_ROLE_GATE=0            # academy: hub lessons refuse roleless members (free preview stays open)
# SML_ACADEMY_BILLING_IN_DISCORD_LINKS=0 # API + academy: one-time buy links in the Activity and hub
# SML_ACADEMY_BILLING_PUBLIC_URL=        # API + academy: https://making-easy-money-academy.onrender.com
# SML_ACADEMY_BILLING_ENABLED=0          # academy: engine master switch (other SML_ACADEMY_BILLING_* in LAUNCH.md)
# SML_ACADEMY_BILLING_CHECKOUT_ENABLED=0 # academy: the only switch that can lead to a charge
# SML_ACADEMY_BILLING_EXTERNAL_ROLE_IDS= # academy: roles a price may grant but not own (default Monarch,Elite,Premium)
# SML_ACADEMY_BILLING_UC_MATCH=any       # academy: any active Upgrade.Chat upgrade keeps an engine-granted external role; 'mapped' = only UC_ROLE_PRODUCTS_JSON products
# SML_ACADEMY_BILLING_UC_ROLE_PRODUCTS_JSON= # academy, UC_MATCH=mapped only: {"<role id>":["<Upgrade.Chat product uuid>"]}
# UPGRADE_CHAT_CLIENT_ID= / UPGRADE_CHAT_CLIENT_SECRET= # academy too: without them external roles are never removed (needs_review)
# SML_LIFECYCLE_SKIP_ROWLESS=0           # API: set 1 before Academy checkout (BILLING-DEPLOY.md)
# SML_BILLING_OUTBOX_MAX_ATTEMPTS=       # worker: set 20 before Academy checkout (BILLING-DEPLOY.md)
