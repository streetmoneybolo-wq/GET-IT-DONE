DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
SECURITY_GATE_MEMBERS_INTENT=0
MASSIVE_API_KEY=
OPENAI_API_KEY=
OPENAI_ARTICLE_MODEL=gpt-4o
WP_BASE_URL=https://stockmarketloop.com
WP_USERNAME=
WP_APP_PASSWORD=
ARTICLE_POLL_SECONDS=120
# Put at least five consented, relevant X handles in config/x-handles.txt.

# --- PayPal Payouts (kept in the deployed environment, never committed) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live or sandbox. Default live.
PAYPAL_ENV=
# 1 is required before ANY payout action can run.
PAYPAL_PAYOUTS_ENABLED=
# Dry run is ON unless this is exactly 0.
PAYPAL_PAYOUT_DRY_RUN=

# --- Daily payout cycle (all optional; safe defaults) ---
# 64 hex chars (32 bytes). Required before members can save payout addresses
# with /paypal set. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_DETAILS_KEY=
# 1 lets the scheduled daily cycle EXECUTE payments (still requires
# PAYPAL_PAYOUTS_ENABLED=1 and PAYPAL_PAYOUT_DRY_RUN=0). Anything else = preview.
PAYOUT_AUTO_DAILY=
# Minimum payable balance (USD) before a member is included in a daily run. Default 5.
PAYOUT_MIN_USD=
# Total cap (USD) a single daily run may pay across all members. Default 200.
PAYOUT_DAILY_CAP_USD=
# UTC hour (0-23) the daily cycle runs. Default 15.
PAYOUT_DAILY_HOUR_UTC=
